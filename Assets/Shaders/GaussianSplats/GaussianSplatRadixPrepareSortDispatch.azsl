#include <Atom/Features/SrgSemantics.azsli>
#include "GaussianSplatCommon.azsli"

// Single-thread pass: computes the entry count and the DispatchIndirectCommand buffers that
// GlobalHistogram/Onesweep/Unpack consume, from GaussianSplatRadixBuildKeysPass's GPU-only entry
// counter, rather than each of those stages relying on a CPU-pushed fixed capacity.
ShaderResourceGroup PassSrg : SRG_PerPass
{
    StructuredBuffer<uint> m_entryCounter;
    RWStructuredBuffer<uint> m_countsOut;
    RWStructuredBuffer<uint> m_blockDispatchArgsOut;
    RWStructuredBuffer<uint> m_unpackArgsOut;

    uint m_entryCapacity;
}

[numthreads(1, 1, 1)]
void MainCS()
{
    // m_entryCounter can itself overshoot m_entryCapacity (BuildKeys's InterlockedAdd runs before its own
    // per-write capacity check) - clamp here too, since this value sizes every later stage's dispatch/bounds-check.
    const uint entryCount = min(PassSrg::m_entryCounter[0], PassSrg::m_entryCapacity);
    const uint blockCount = (entryCount + RadixBlockSize - 1) / RadixBlockSize;

    PassSrg::m_countsOut[0] = entryCount;
    PassSrg::m_countsOut[1] = PassSrg::m_entryCounter[0]; // raw, unclamped - for CPU-side overflow detection

    PassSrg::m_blockDispatchArgsOut[0] = blockCount;
    PassSrg::m_blockDispatchArgsOut[1] = 1;
    PassSrg::m_blockDispatchArgsOut[2] = 1;

    PassSrg::m_unpackArgsOut[0] = (entryCount + 255) / 256;
    PassSrg::m_unpackArgsOut[1] = 1;
    PassSrg::m_unpackArgsOut[2] = 1;
}
