#include <Atom/Features/SrgSemantics.azsli>

// Single-thread pass: turns the GPU-only visible-splat counter into the DispatchIndirectCommand that
// GaussianSplatRadixBuildKeysPass dispatches from, so it only launches thread groups covering the real
// visible splat count instead of always dispatching over the m_totalSplatCount upper bound.
ShaderResourceGroup PassSrg : SRG_PerPass
{
    StructuredBuffer<uint> m_visibleCounter;
    RWStructuredBuffer<uint> m_dispatchArgsOut;

    uint m_totalSplatCount;
}

[numthreads(1, 1, 1)]
void MainCS()
{
    // m_visibleCounter can itself exceed m_totalSplatCount (ProjectCull's InterlockedAdd runs before its own
    // bounds check) - clamp here too, since an unclamped value would launch BuildKeys threads reading past
    // ProjectCull's compacted output buffers.
    const uint visibleCount = min(PassSrg::m_visibleCounter[0], PassSrg::m_totalSplatCount);
    const uint groupCount = (visibleCount + 255) / 256;

    PassSrg::m_dispatchArgsOut[0] = groupCount;
    PassSrg::m_dispatchArgsOut[1] = 1;
    PassSrg::m_dispatchArgsOut[2] = 1;
}
