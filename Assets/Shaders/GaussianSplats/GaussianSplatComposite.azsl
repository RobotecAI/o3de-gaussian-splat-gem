#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertexUtil.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertexInfo.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>

// Composites GaussianSplatTileShading.azsl's offscreen accumulation image into the scene color via a
// full-screen triangle with premultiplied-alpha blending - rgb is already alpha-weighted, so it's added as-is.
ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_accumulation;
}

VSOutput MainVS(VSInput input)
{
    VSOutput OUT;
    float4 posTex = GetVertexPositionAndTexCoords(input.m_vertexID);
    OUT.m_position = float4(posTex.x, posTex.y, 0.0, 1.0);
    OUT.m_texCoord = posTex.zw;
    return OUT;
}

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;
    const uint2 screenCoords = uint2(IN.m_position.xy);
    OUT.m_color = PassSrg::m_accumulation.Load(uint3(screenCoords, 0));
    return OUT;
}
